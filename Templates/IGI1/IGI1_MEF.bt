//------------------------------------------------
//--- 010 Editor v9.0.1 Binary Template
//
//      File: IGI1_MEF.bt
//   Authors: Rotari Artiom
//   Version: 1.1
//   Purpose: IGI 1 MEF / ILFF parser with bone-model (model_type 1) records
//  Category: Game
// File Mask: ILFF
//  ID BYTEs:
//   History:
//     1.1 - issue #7: named HSEM counts, variable-length DNER, distinct
//           XTRV case 1 (40-byte bone vertex), XTVC bone index, and optional
//           REIH/MANB structs. See Research/MEF/IGI1_MEF_BONES.md for evidence.
//------------------------------------------------


#include "../COMMON/TYPES.bt";
#include "../COMMON/ILFF.bt";
#include "../COMMON/ALIGNMENT.bt";
#include "../COMMON/STRINGS.bt";
#include "../COMMON/VECTORS.bt";
#include "../COMMON/DATETIME.bt";



LittleEndian();


enum <U4> MT
{
    MODEL_RIGID    = 0,
    MODEL_BONE     = 1,
    MODEL_LIGHTMAP = 3,
};


typedef struct HSEM
{
    ILFF_HEADER header;

    U4 _0;
    U4 yy;  // datetime
    U4 mm;  // datetime
    U4 dd;  // datetime
    U4 hh;  // datetime
    U4 mn;  // datetime
    U4 ss;  // datetime
    U4 ms;  // datetime
    U4 mt;  // modeltype
    U4 _1;  // 0
    U4 _2;  // 0
    U4 _3;  // 0
    F4 f0;
    F4 f1;
    F4 f2;
    F4 f3;
    F4 f4;
    F4 f5;
    F4 f6;
    F4 f7;
    F4 f8;
    F4 f9;
    F4 fa;
    F4 fb;
    U4 _4;  // num_r_faces  (render faces)
    U4 _5;  // num_r_verts  (render vertices)
    U4 _6;  // num_r_buffer (d3dr/dner/xtrv/pmtl byte count)
    U4 _7;  // sum_c_faces
    U4 _8;  // sum_c_verts
    U4 _9;  // sum_c_buffer
    F4 fc;  // model radius
    U2 _a;  // num_mverts
    U2 _b;  // num_attachments
    U2 _c;  // num_pverts
    U2 _d;  // num_pfaces
    U2 _e;  // num_portals
    U2 _f;  // bone-count candidate in some MEFs; not verified in IGI1 samples
    U1 rs[20]; // padding / reserved (kept at 20 so the 156-byte size is unchanged)

    Padding();
};

//------------------------------------------------
// OPTIONAL BONE CHUNKS
// Adapted from Templates/IGI2/IGI2_MEF.bt. The IGI 1 bone samples used for
// issue #7 do NOT contain REIH/MANB: bone membership is carried by the 40-byte
// XTRV records (field bn) and bone names come from the animation file. These
// structs are provided so that a file which does contain them still parses;
// their presence in IGI 1 is not asserted.
//------------------------------------------------
struct HBONE1;

typedef struct
{
    UBYTE child_count;

    local UBYTE boneid = bone_id++;
    local UBYTE i = 0;

    for(i = 0; i < child_count; i++)
        HBONE1 bone;
} HBONE1 <read=Read_HBONE1>;

string Read_HBONE1(HBONE1 &o)
{
    // MANB is optional in IGI 1, so do not reference it here; names remain
    // visible in the MANB struct itself when that chunk is present.
    local string s = "";
    SPrintf(s, "bone %d", o.boneid);
    return s;
};

typedef struct REIH
{
    ILFF_HEADER header;

    local UBYTE bone_id = 0;
    HBONE1 root;

    Align(4);

    FVECTOR3 bone_position[bone_id];

    Padding();
};

typedef struct MANB
{
    ILFF_HEADER header;

    FSTRING bone_name(16)[header.datasize / 16];

    Padding();
};

// ATTACHMENT DEFINE
typedef struct ATTA
{
    ILFF_HEADER header;

    struct
    {
        CH name[16];
        F4 px;
        F4 py;
        F4 pz;
        F4 _0;
        F4 _1;
        F4 _2;
        F4 _3;
        F4 _4;
        F4 _5;
        F4 _6;
        F4 _7;
        F4 _8;
        S4 _9;
    } attachment[header.datasize / 68];

    Padding();
};

// MAGIC VERTICES
typedef struct XTVM
{
    ILFF_HEADER header;

    struct
    {
        F4 px;
        F4 py;
        F4 pz;
        S4 _0;
    } vertex[header.datasize / 16];

    Padding();
};

// PORTAL DEFINE
typedef struct TROP
{
    ILFF_HEADER header;

    struct
    {
        U4 o_vertex;
        U4 n_vertex;
        U4 o_face;
        U4 n_face;
        U4 id;
    } portal[header.datasize / 20];

    Padding();
};

// PORTAL VERTICES
typedef struct XVTP
{
    ILFF_HEADER header;

    struct
    {
        F4 px;
        F4 py;
        F4 pz;
    } vertex[header.datasize / 12];

    Padding();
};

// PORTAL FACES
typedef struct CFTP
{
    ILFF_HEADER header;

    struct
    {
        U4 a;
        U4 b;
        U4 c;
    } face[header.datasize / 12];

    Padding();
};

// RENDER MESH HEADER
typedef struct D3DR
{
    ILFF_HEADER header;

    switch(igi1_mef.hsem.mt)
    {
        case 0:
            U4 _0;     // 4
            U4 fn;     // face num
            U4 mn;     // mesh num
            U4 vn;     // vert num
            U4 rs[8];  // 0
        break;

        case 1:
            U4 _0;     // 4
            U4 fn;     // face num
            U4 mn;     // mesh num
            U4 v0;     // vert num 0
            U4 v1;     // vert num 1
            U4 vn;     // vert num
            U4 rs[8];  // 0
        break;

        case 3:
            U4 _0;     // 4
            U4 ln;     // lmap num
            U4 fn;     // face num
            U4 mn;     // mesh num
            U4 vn;     // vert num
            U4 _5;     // 0
            U4 _6;     // 
            U4 rs[7];  // 0
        break;
    }

    Padding();
};

// RENDER MESH DEFINE
// DNER is a sequence of variable-length records: 28-byte header (rigid/bone)
// or 32-byte header (lightmap) followed by num_face uint16 face indices.
// Measured with the Python converter: 428/428 rigid and 126/126 bone samples
// from the supplied archive have HSEM face/vertex counts that match this
// record walk (Research/MEF/MEF_PYTHON_CONVERTER.md).
typedef struct DNER_0
{
    F4 px;
    F4 py;
    F4 pz;
    U2 num_face;
    U2 nextoffs;
    S2 _td;
    U2 off_verts;
    U2 num_verts;
    U2 _opacity;
    U1 _Eflame;
    U1 _mshine;
    U1 _Scolor;
    U1 _Opacitd;
    U2 face[num_face];
};

typedef struct DNER_3
{
    F4 px;
    F4 py;
    F4 pz;
    U2 num_face;
    U2 nextoffs;
    S2 _td;
    S2 _lmap;
    U2 off_verts;
    U2 num_verts;
    U2 _opacity;
    U2 _0;
    U1 _Eflame;
    U1 _mshine;
    U1 _mcolor;
    U1 _Opacitd;
    U2 face[num_face];
};

typedef struct DNER
{
    ILFF_HEADER header;

    local U4 end = FTell() + header.datasize;

    while(FTell() < end)
    {
        switch(igi1_mef.hsem.mt)
        {
            case 0:
            case 1:
                DNER_0 mesh;
            break;

            case 3:
                DNER_3 mesh;
            break;
        }
    }

    Padding();
};

// RENDER MESH VERTICES
typedef struct XTRV
{
    ILFF_HEADER header;

    switch(igi1_mef.hsem.mt)
    {
        case 0:
        struct
        {
            F4 px;
            F4 py;
            F4 pz;
            F4 nx;
            F4 ny;
            F4 nz;
            F4 u0;
            F4 v0;
        } vertex[header.datasize / 32];
        break;

        // Bone model: same 40-byte stride as lightmap models but the last
        // four fields are (w, local vertex id, bone index), NOT a second UV.
        // Checked against 126 archive bone samples: datasize % 40 == 0 and
        // the bn field indexes a bone table (values well above 48 occur).
        case 1:
        struct
        {
            F4 px;
            F4 py;
            F4 pz;
            F4 nx;
            F4 ny;
            F4 nz;
            F4 u0;
            F4 v0;
            F4 w;
            U2 vn;
            U2 bn;
        } vertex[header.datasize / 40];
        break;

        case 3:
        struct
        {
            F4 px;
            F4 py;
            F4 pz;
            F4 nx;
            F4 ny;
            F4 nz;
            F4 u0;
            F4 v0;
            F4 u1;
            F4 v1;
        } vertex[header.datasize / 40];
        break;
    }

    Padding();
};

// RENDER MESH LIGHTMAPS
typedef struct PMTL
{
    ILFF_HEADER header;

    struct
    {
        U2 _0;  // 
        U2 _1;  // 
        U2 _2;  // 
        U2 _3;  // 
    } unk[header.datasize / 8];

    Padding();
};

// COLLISION MESH HEADER
typedef struct HSMC
{
    ILFF_HEADER header;

    struct
    {
        U4 fn;  //
        U4 vn;  //
        U4 mn;  //
        U4 sn;  //
        U4 _0;  // 0
        U4 _1;  // 0
        U4 _2;  // 0
        U4 _3;  // 0
    } cmesh[2];

    Padding();
};

// COLLISION MESH VERTICES
typedef struct XTVC
{
    ILFF_HEADER header;

    struct
    {
        F4 px;
        F4 py;
        F4 pz;
        U4 bn;  // bone index on bone models (issue #7)
    } vertex[header.datasize / 16];

    Padding();
};

// COLLISION MESH FACES
typedef struct ECFC
{
    ILFF_HEADER header;

    struct
    {
        U2 a;
        U2 b;
        U2 c;
        U2 _mat;
    } face[header.datasize / 8];

    Padding();
};

// COLLISION MESH MATERIALS
typedef struct TAMC
{
    ILFF_HEADER header;

    struct
    {
        S2 _0;
        S2 _1;
        S2 _2;
        S2 _3;
        S2 _4;
        S2 _5;
    } material[header.datasize / 12];

    Padding();
};

// COLLISION MESH SPH
typedef struct HPSC
{
    ILFF_HEADER header;

    struct
    {
        F4 _0;  // -257428.67  645599.25
        F4 _1;  // -389401.2   391259.34
        F4 _2;  // -497025.03  485629.94
        F4 _3;  //  2.938633   516600.06
        S2 _4;  // -1          3287
        S2 _5;  //  0          1
        S2 _6;  //  0          6573
        S2 _7;  //  0          6574
    } sph [header.datasize / 24];

    Padding();
};

// TXAN
typedef struct TXAN
{
    ILFF_HEADER header;

    U1 _0[header.datasize];

    Padding();
};




struct
{
    ILFF_HEADER header;
    CH formatid[4];  // OCEM

    while(FTell() < FileSize())
    {
        switch(ReadString(FTell(), 4))
        {
            case "HSEM": HSEM hsem; break;
            // Optional; not present in the audited IGI 1 bone samples.
            case "REIH": REIH reih; break;
            case "MANB": MANB manb; break;
            case "ATTA": ATTA atta; break;
            case "XTVM": XTVM xtvm; break;
            case "TROP": TROP trop; break;
            case "XVTP": XVTP xvtp; break;
            case "CFTP": CFTP cftp; break;
            case "D3DR": D3DR d3dr; break;
            case "DNER": DNER dner; break;
            case "XTRV": XTRV xtrv; break;
            case "PMTL": PMTL pmtl; break;
            case "HSMC": HSMC hsmc; break;
            case "XTVC": XTVC xtvc; break;
            case "ECFC": ECFC ecfc; break;
            case "TAMC": TAMC tamc; break;
            case "HPSC": HPSC hpsc; break;
            case "TXAN": TXAN txan; break;
            default: Assert(false, "Parsing error: unhandled block type");
        }
    }
} igi1_mef;


Assert(FEof(), "Parsing error: expected end of file");
